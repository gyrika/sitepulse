{
  "name": "sitepulse-server",
  "version": "0.1.0",
  "private": true,
  "description": "SitePulse API and monitoring worker",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:dev": "node scripts/dev-db.js",
    "mail:dev": "node scripts/dev-mail.js",
    "alert:test": "node --env-file-if-exists=.env scripts/send-test-alert.js",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "mongoose": "^9.11.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.21.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
