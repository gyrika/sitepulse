# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Local example. For a hosted database, keep the username and password here only.
MONGODB_URI=mongodb://127.0.0.1:27017/sitepulse

# Required, at least 32 characters. Generate one with: npm run token
# Used by scripts and curl.
ADMIN_API_TOKEN=

# Required, at least 12 characters. The password for signing in to the dashboard.
ADMIN_PASSWORD=

# Required, at least 32 characters. Signs login sessions. Generate one with: npm run token
SESSION_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API. Leave at 0 when there are none.
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=300

# Outbound check limits.
CHECK_TIMEOUT_MS=10000
CHECK_MAX_RESPONSE_BYTES=1048576
CHECK_MAX_CONCURRENCY=20

# Email alerts. Leave SMTP_HOST empty to turn them off; monitoring works the same either way.
# For local testing, run `npm run mail:dev` and use: SMTP_HOST=127.0.0.1, SMTP_PORT=1025,
# SMTP_SECURITY=none. Prove your settings work with: npm run alert:test
SMTP_HOST=
# Defaults to 587, or 465 when SMTP_SECURITY=tls.
SMTP_PORT=
# starttls (default), tls, or none. "none" is only accepted for a server on this machine.
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Required when SMTP_HOST is set. ALERT_EMAIL_TO can be a comma-separated list.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Optional. Adds a link to the monitor's page in each email.
DASHBOARD_URL=http://localhost:5173
